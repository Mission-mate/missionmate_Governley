{
  "name": "ProgramDeliverableReport",
  "type": "object",
  "properties": {
    "deliverable_id": {
      "type": "string",
      "description": "Parent ProgramDeliverable ID this reporting row belongs to"
    },
    "parent_id": {
      "type": "string",
      "description": "Parent reporting period row ID; set on category child rows only"
    },
    "location_id": {
      "type": "string",
      "description": "Category ID from the deliverable's reporting_locations; set on category child rows only"
    },
    "period_label": {
      "type": "string",
      "description": "Reporting period display label, e.g. Q1 2026"
    },
    "period_date": {
      "type": "string",
      "format": "date",
      "description": "Anchor date of the reporting period, used for ordering"
    },
    "expected": {
      "type": "number"
    },
    "actual": {
      "type": "number"
    },
    "total_expected": {
      "type": "number",
      "description": "Total target used for Progress % calculation"
    },
    "baseline": {
      "type": "number",
      "description": "Fixed point of reference for benchmarking"
    },
    "custom_values": {
      "type": "object",
      "description": "Map of custom column id to value for this row"
    },
    "order_index": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "deliverable_id"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}