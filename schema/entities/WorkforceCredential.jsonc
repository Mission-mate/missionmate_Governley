{
  "name": "WorkforceCredential",
  "type": "object",
  "properties": {
    "register_id": {
      "type": "string"
    },
    "person_id": {
      "type": "string",
      "description": "Parent WorkforcePerson ID"
    },
    "credential_name": {
      "type": "string",
      "description": "Credential type, e.g. National Police Check"
    },
    "reference_number": {
      "type": "string",
      "description": "Licence / certificate number (shown masked)"
    },
    "jurisdiction": {
      "type": "string",
      "description": "e.g. National or State/Territory"
    },
    "no_expiry": {
      "type": "boolean",
      "default": false
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "Verified",
        "Pending",
        "Exempted"
      ],
      "default": "Pending"
    },
    "verified_date": {
      "type": "string",
      "format": "date",
      "description": "Date verified; never in the future"
    },
    "restricted": {
      "type": "boolean",
      "default": false,
      "description": "Sensitive record, reference hidden"
    },
    "note": {
      "type": "string"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "verified_by": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Archived"
      ],
      "default": "Active",
      "description": "Credential lifecycle status. Validity (Current/Expired) is always derived from the expiry date."
    },
    "archived_with_person": {
      "type": "boolean",
      "default": false,
      "description": "True when this credential was archived by archiving its person; restoring the person restores only these."
    }
  },
  "required": [
    "register_id",
    "person_id",
    "credential_name"
  ]
}