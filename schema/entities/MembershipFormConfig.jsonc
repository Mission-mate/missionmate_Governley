{
  "name": "MembershipFormConfig",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "description": "Stable identifier used in the public form URL. Defaults to 'default' for the single primary form."
    },
    "organisation_name": {
      "type": "string",
      "description": "Organisation name displayed on the public membership page"
    },
    "title": {
      "type": "string",
      "default": "Become a Member",
      "description": "Public form heading / membership page title"
    },
    "description": {
      "type": "string",
      "description": "Intro text shown under the form heading"
    },
    "support_email": {
      "type": "string",
      "description": "Support email displayed on the membership page for enquiries"
    },
    "social_links": {
      "type": "object",
      "description": "Optional social/website links shown on the public membership page",
      "properties": {
        "facebook": {
          "type": "string",
          "description": "Facebook page URL"
        },
        "instagram": {
          "type": "string",
          "description": "Instagram profile URL"
        },
        "linkedin": {
          "type": "string",
          "description": "LinkedIn page URL"
        },
        "website": {
          "type": "string",
          "description": "Organisation website URL"
        }
      }
    },
    "banner_url": {
      "type": "string",
      "description": "URL of the banner image shown at the top of the public form"
    },
    "success_message": {
      "type": "string",
      "default": "Thank you! Your membership application has been received and is pending review.",
      "description": "Message shown after a successful submission"
    },
    "selected_structure_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "MembershipStructure IDs exposed on this form"
    },
    "structure_rules": {
      "type": "array",
      "description": "Optional conditional visibility rules for membership structures. A structure listed here is only shown on the form when its condition group passes. Structures without an entry are always visible.",
      "items": {
        "type": "object",
        "properties": {
          "structure_id": {
            "type": "string",
            "description": "MembershipStructure ID this rule applies to"
          },
          "conditional_logic": {
            "type": "object",
            "description": "Visibility rule group evaluated against form answers, using the same AND/OR condition-group shape as field conditional_logic.",
            "properties": {
              "match": {
                "type": "string",
                "enum": [
                  "AND",
                  "OR"
                ],
                "default": "AND",
                "description": "How the conditions are combined. AND = all must pass, OR = any must pass."
              },
              "conditions": {
                "type": "array",
                "description": "List of conditions evaluated against other fields' answers",
                "items": {
                  "type": "object",
                  "properties": {
                    "trigger_field_id": {
                      "type": "string",
                      "description": "field_id of a form field whose answer drives this structure's visibility"
                    },
                    "operator": {
                      "type": "string",
                      "enum": [
                        "equals",
                        "not_equals",
                        "contains"
                      ],
                      "description": "Comparison operator"
                    },
                    "value": {
                      "type": "string",
                      "description": "Expected value to compare the trigger field's answer against"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "field_layout": {
      "type": "array",
      "description": "Ordered list of fields rendered on the form",
      "items": {
        "type": "object",
        "properties": {
          "field_id": {
            "type": "string",
            "description": "System key (e.g. first_name) or custom field id"
          },
          "label": {
            "type": "string",
            "description": "Display label override"
          },
          "placeholder": {
            "type": "string",
            "description": "Optional placeholder text shown inside the field on the public form"
          },
          "kind": {
            "type": "string",
            "enum": [
              "system",
              "custom"
            ],
            "default": "system",
            "description": "Whether this is a built-in field or a configured custom field"
          },
          "type": {
            "type": "string",
            "description": "Question type for inline custom questions, e.g. Text/Number/Date/Dropdown (Single Select). Empty for system fields and AppConfig-backed custom fields."
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Choice options for inline select/radio/checkbox questions. Empty for non-option question types."
          },
          "mandatory": {
            "type": "boolean",
            "default": false,
            "description": "Whether the field is required"
          },
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "Whether the field is shown on the form"
          },
          "map_to_field": {
            "type": "string",
            "description": "Member profile field key this answer maps to. Empty = not written to the member profile."
          },
          "visibility_plans": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "MembershipStructure (plan) IDs this question is shown for. Empty = shown for all plans. When set, the question is only shown once the applicant selects one of these plans."
          },
          "conditional_logic": {
            "type": "object",
            "description": "Legacy field-to-field visibility rule group (custom fields only). Superseded by visibility_plans. Retained for backward compatibility.",
            "properties": {
              "match": {
                "type": "string",
                "enum": [
                  "AND",
                  "OR"
                ],
                "default": "AND",
                "description": "How the conditions are combined. AND = all must pass, OR = any must pass."
              },
              "conditions": {
                "type": "array",
                "description": "List of conditions evaluated against other fields' answers",
                "items": {
                  "type": "object",
                  "properties": {
                    "trigger_field_id": {
                      "type": "string",
                      "description": "field_id of another field whose answer drives this field's visibility"
                    },
                    "operator": {
                      "type": "string",
                      "enum": [
                        "equals",
                        "not_equals",
                        "contains"
                      ],
                      "description": "Comparison operator"
                    },
                    "value": {
                      "type": "string",
                      "description": "Expected value to compare the trigger field's answer against"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disabled"
      ],
      "default": "active",
      "description": "Whether the public form accepts submissions"
    }
  },
  "required": [
    "slug"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}