{
  "name": "ProjectDeliverableTask",
  "type": "object",
  "properties": {
    "deliverable_id": {
      "type": "string",
      "description": "Parent ProjectDeliverable ID this task belongs to"
    },
    "section_id": {
      "type": "string",
      "description": "ID of the section record this task/milestone is grouped under. Empty = ungrouped."
    },
    "type": {
      "type": "string",
      "enum": [
        "task",
        "milestone",
        "section"
      ],
      "default": "task"
    },
    "custom_id": {
      "type": "string",
      "description": "Human-readable, user-editable record ID"
    },
    "title": {
      "type": "string"
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "owner": {
      "type": "string"
    },
    "health": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "priority": {
      "type": "string"
    },
    "effectiveness": {
      "type": "string"
    },
    "progress": {
      "type": "number",
      "default": 0
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "author_name": {
            "type": "string"
          },
          "added_at": {
            "type": "string"
          }
        }
      }
    },
    "custom_values": {
      "type": "object",
      "description": "Map of custom column id to value"
    },
    "order_index": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "deliverable_id",
    "title"
  ]
}