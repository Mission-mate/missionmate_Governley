{
  "name": "Contract",
  "type": "object",
  "properties": {
    "register_id": {
      "type": "string",
      "description": "Parent ComplianceManagedRegister ID (Contract Register)"
    },
    "contract_code": {
      "type": "string",
      "description": "Contract reference, e.g. CON-001 (unique within the register)"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "contract_type": {
      "type": "string",
      "description": "From register config.contract_types"
    },
    "has_financial_value": {
      "type": "boolean",
      "default": false
    },
    "value": {
      "type": "number",
      "description": "Contract value"
    },
    "payment_schedule": {
      "type": "array",
      "description": "Payment schedule rows stored with the contract",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          }
        }
      }
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "review_frequency": {
      "type": "string",
      "enum": [
        "Monthly",
        "Quarterly",
        "Biannually",
        "Annually",
        "Every",
        "Ad Hoc"
      ]
    },
    "interval_value": {
      "type": "number",
      "description": "Custom interval, used only when review_frequency is 'Every'"
    },
    "interval_unit": {
      "type": "string",
      "enum": [
        "Months",
        "Years"
      ]
    },
    "last_review_date": {
      "type": "string",
      "format": "date"
    },
    "next_review_date": {
      "type": "string",
      "format": "date",
      "description": "Auto-calculated from frequency and last review date"
    },
    "owner": {
      "type": "string",
      "description": "Contract owner"
    },
    "manager": {
      "type": "string",
      "description": "Contract manager"
    },
    "business_division": {
      "type": "string",
      "description": "The business area the contract relates to"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Archived"
      ],
      "default": "Active"
    },
    "party_name": {
      "type": "string",
      "description": "Counterparty name"
    },
    "party_contact": {
      "type": "string",
      "description": "Counterparty contact person"
    },
    "party_email": {
      "type": "string"
    },
    "party_phone": {
      "type": "string"
    },
    "additional_parties": {
      "type": "array",
      "description": "Up to three additional parties to the contract",
      "items": {
        "type": "object",
        "properties": {
          "party_name": {
            "type": "string"
          },
          "party_contact": {
            "type": "string"
          },
          "party_email": {
            "type": "string"
          },
          "party_phone": {
            "type": "string"
          }
        }
      }
    },
    "custom_fields": {
      "type": "object",
      "description": "Values for config.custom_columns keyed by column id"
    }
  },
  "required": [
    "register_id",
    "contract_code",
    "title",
    "status"
  ]
}