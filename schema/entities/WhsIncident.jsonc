{
  "name": "WhsIncident",
  "type": "object",
  "properties": {
    "register_id": {
      "type": "string"
    },
    "incident_code": {
      "type": "string",
      "description": "e.g. INC-001"
    },
    "title": {
      "type": "string",
      "description": "Incident title"
    },
    "description": {
      "type": "string"
    },
    "incident_type": {
      "type": "string",
      "description": "From register config.incident_types"
    },
    "incident_date": {
      "type": "string",
      "format": "date"
    },
    "location": {
      "type": "string"
    },
    "person_exposed": {
      "type": "string"
    },
    "person_type": {
      "type": "string",
      "description": "e.g. employee, contractor"
    },
    "treatment": {
      "type": "string",
      "description": "From register config.treatments"
    },
    "business_impact": {
      "type": "string",
      "enum": [
        "No Impact",
        "Minor",
        "Limited",
        "Major",
        "Catastrophic"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "Open",
        "Closed"
      ],
      "default": "Open"
    },
    "date_closed": {
      "type": "string",
      "format": "date"
    },
    "investigation_required": {
      "type": "string",
      "enum": [
        "Yes",
        "No"
      ]
    },
    "investigation_status": {
      "type": "string",
      "enum": [
        "Not Started",
        "In Progress",
        "Completed",
        "On Hold",
        "Cancelled"
      ]
    },
    "regulator_notification": {
      "type": "string",
      "enum": [
        "Yes",
        "Not Required"
      ]
    },
    "regulator_notified_date": {
      "type": "string",
      "format": "date"
    },
    "regulator_reference": {
      "type": "string"
    },
    "custom_fields": {
      "type": "object",
      "description": "Values for config.incident_custom_columns keyed by column id"
    }
  },
  "required": [
    "register_id"
  ]
}