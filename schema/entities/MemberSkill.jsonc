{
  "name": "MemberSkill",
  "type": "object",
  "properties": {
    "person_id": {
      "type": "string",
      "description": "Parent BoardPerson record ID"
    },
    "skill_id": {
      "type": "string",
      "description": "Linked BoardSkill record ID"
    },
    "skill_name": {
      "type": "string",
      "description": "Cached skill name for display"
    },
    "level": {
      "type": "number",
      "default": 3,
      "description": "Proficiency level 1-3 (3 = Strong Expertise, 2 = Working Knowledge, 1 = Basic Understanding). Values outside 1-3 are clamped on write."
    }
  },
  "required": [
    "person_id",
    "skill_id"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}