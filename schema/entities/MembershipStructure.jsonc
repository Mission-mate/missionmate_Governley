{
  "name": "MembershipStructure",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Structure name, e.g. Annual Membership"
    },
    "membership_type": {
      "type": "string",
      "enum": [
        "Individual",
        "Group",
        "Organisation"
      ],
      "default": "Individual",
      "description": "Deprecated. Who the membership structure applies to. No longer configured in the plan wizard."
    },
    "description": {
      "type": "string",
      "description": "Optional description of the structure, displayed to new members on signup"
    },
    "plan_content_sections": {
      "type": "array",
      "description": "Additional customisable content sections (e.g. Membership Rights, Membership Benefits) displayed to new members on signup",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique section id"
          },
          "title": {
            "type": "string",
            "description": "Section heading, e.g. Membership Benefits"
          },
          "content": {
            "type": "string",
            "description": "Rich-text (HTML) body content, supports links"
          }
        }
      }
    },
    "has_tiers": {
      "type": "boolean",
      "default": false,
      "description": "Whether this plan has multiple categories/tiers (e.g. Individual and Organisation)"
    },
    "tier_fees_differ": {
      "type": "boolean",
      "default": false,
      "description": "Whether each category/tier has a different membership fee"
    },
    "tiers": {
      "type": "array",
      "description": "Configured categories/tiers for this plan",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique tier id"
          },
          "name": {
            "type": "string",
            "description": "Tier/category name, e.g. Individual"
          },
          "description": {
            "type": "string",
            "description": "Optional description of the tier/category"
          },
          "fee_amount": {
            "type": "number",
            "description": "Fee for this tier, used when tier_fees_differ is true"
          },
          "payment_link": {
            "type": "string",
            "description": "Optional per-tier online payment link. Treated as the one-time link for backward compatibility when one_time_payment_link is not set."
          },
          "one_time_payment_link": {
            "type": "string",
            "description": "Per-tier online payment link for a one-time (non-recurring) membership payment"
          },
          "recurrent_payment_link": {
            "type": "string",
            "description": "Per-tier online payment link for a recurrent (auto-rebilling subscription) membership payment"
          }
        }
      }
    },
    "price": {
      "type": "number",
      "default": 0,
      "description": "Membership price"
    },
    "fee_type": {
      "type": "string",
      "enum": [
        "Free",
        "Fixed",
        "Tiered",
        "Custom",
        "No Membership Fee"
      ],
      "default": "Free",
      "description": "How this plan is priced. Free = no fee, Fixed = single fee, Tiered = per-tier fees, Custom = manual amount. 'No Membership Fee' retained for legacy records."
    },
    "fee_amount": {
      "type": "number",
      "default": 0,
      "description": "Fixed/custom membership fee amount (used when fee_type is Fixed or Custom)"
    },
    "payment_methods": {
      "type": "array",
      "description": "Accepted payment methods shown to members during registration",
      "items": {
        "type": "string",
        "enum": [
          "Cash",
          "Bank Transfer",
          "Online Payment",
          "Invoice"
        ]
      }
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "Cash",
        "Bank Transfer",
        "Payment Link"
      ],
      "description": "Deprecated single payment method. Superseded by payment_methods array."
    },
    "payment_link": {
      "type": "string",
      "description": "External online payment link URL. Treated as the one-time payment link for backward compatibility when one_time_payment_link is not set."
    },
    "online_payment_type": {
      "type": "string",
      "enum": [
        "one_time",
        "both"
      ],
      "default": "one_time",
      "description": "For Online Payment: whether this plan accepts only one-time membership payments, or both one-time and recurrent (auto-rebilling subscription) payments."
    },
    "one_time_payment_link": {
      "type": "string",
      "description": "Online payment link for a one-time (non-recurring) membership payment"
    },
    "recurrent_payment_link": {
      "type": "string",
      "description": "Online payment link for a recurrent (auto-rebilling subscription) membership payment"
    },
    "bank_account_name": {
      "type": "string",
      "description": "Bank account name (shown to members when Bank Transfer is accepted)"
    },
    "bank_bsb": {
      "type": "string",
      "description": "Bank BSB number (shown to members when Bank Transfer is accepted)"
    },
    "bank_account_number": {
      "type": "string",
      "description": "Bank account number (shown to members when Bank Transfer is accepted)"
    },
    "bank_payment_reference": {
      "type": "string",
      "description": "Optional payment reference instructions for Bank Transfer"
    },
    "show_pay_id": {
      "type": "boolean",
      "default": false,
      "description": "Whether to show PayID details instead of / in addition to BSB & account number for Bank Transfer"
    },
    "pay_id": {
      "type": "string",
      "description": "PayID (email or phone) shown to members for bank transfer payment"
    },
    "stripe_product_id": {
      "type": "string",
      "description": "Linked Stripe product ID for the membership fee"
    },
    "stripe_product_name": {
      "type": "string",
      "description": "Cached Stripe product name for display"
    },
    "duration_months": {
      "type": "number",
      "default": 12,
      "description": "Duration in months used to auto-calculate expiration date (ignored when is_lifetime is true). Derived from the renewal period \u2014 for 'Every' it is renewal_interval_value x (12 when the unit is Years)."
    },
    "is_lifetime": {
      "type": "boolean",
      "default": false,
      "description": "When true, membership never expires and duration is ignored"
    },
    "renewal_period": {
      "type": "string",
      "enum": [
        "One-off",
        "Annually",
        "Lifetime (No Expiration)",
        "Every"
      ],
      "default": "Annually",
      "description": "Renewal period. One-off = single fixed term, Annually = yearly, Lifetime = never expires, Every = custom cadence set by renewal_interval_value/renewal_interval_unit."
    },
    "renewal_interval_value": {
      "type": "number",
      "default": 1,
      "description": "Custom renewal interval value, used when renewal_period is 'Every' (e.g. 3 for a three-year renewal)"
    },
    "renewal_interval_unit": {
      "type": "string",
      "enum": [
        "Months",
        "Years"
      ],
      "default": "Years",
      "description": "Custom renewal interval unit, used when renewal_period is 'Every'"
    },
    "renewal_calculation": {
      "type": "string",
      "enum": [
        "Based on date joined",
        "Fixed renewal date",
        "Financial year cycle",
        "Calendar year cycle"
      ],
      "default": "Based on date joined",
      "description": "How the renewal/expiration date is calculated"
    },
    "renewal_expiration_type": {
      "type": "string",
      "enum": [
        "Calculated by date joined",
        "On Specific Date"
      ],
      "default": "Calculated by date joined",
      "description": "Deprecated. Superseded by renewal_calculation."
    },
    "specific_expiration_day": {
      "type": "number",
      "description": "Day of month (1-31) for the fixed renewal date"
    },
    "specific_expiration_month": {
      "type": "number",
      "description": "Month (1-12) for the fixed renewal date"
    },
    "grace_period_days": {
      "type": "number",
      "default": 0,
      "description": "Grace period in days after expiry before action is taken (0, 14, 30, 60 or 90)"
    },
    "after_grace_period": {
      "type": "string",
      "enum": [
        "Mark as expired",
        "Keep active until admin review"
      ],
      "default": "Mark as expired",
      "description": "What happens once the grace period ends"
    },
    "admin_approval_required": {
      "type": "boolean",
      "default": false,
      "description": "When true, new members on this structure are saved as 'pending' and must be manually activated by an admin"
    },
    "deactivate_expired_memberships": {
      "type": "boolean",
      "default": false,
      "description": "When true, members on this structure are automatically set to 'expired' once their renewal/expiration date passes"
    },
    "welcome_email_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Automatically send welcome emails to new members"
    },
    "renewal_reminder_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Automatically notify members before membership expiration"
    },
    "expiry_reminder_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Automatically notify members after membership expires"
    },
    "is_system_default": {
      "type": "boolean",
      "default": false,
      "description": "When true, this is a seeded default structure and cannot be deleted"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active",
      "description": "Structure lifecycle status"
    },
    "application_fields": {
      "type": "array",
      "description": "Google-Forms-style application questions collected when this plan is selected. Each question may optionally map to a member profile field; unmapped answers are stored only in the submission history.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique question id"
          },
          "type": {
            "type": "string",
            "description": "Question type, e.g. Text, Number, Dropdown (Single Select)"
          },
          "label": {
            "type": "string",
            "description": "Question text shown to the applicant"
          },
          "help_text": {
            "type": "string",
            "description": "Optional helper text under the question"
          },
          "required": {
            "type": "boolean",
            "default": false,
            "description": "Whether the applicant must answer"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Choice options for select/radio/checkbox questions"
          },
          "map_to_field": {
            "type": "string",
            "description": "Member field key/id this answer maps to. Empty = response-only, not written to the member profile."
          },
          "map_to_type": {
            "type": "string",
            "description": "Cached member field type of the mapped field, used for validation"
          }
        }
      }
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}