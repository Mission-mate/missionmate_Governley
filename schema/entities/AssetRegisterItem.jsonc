{
  "name": "AssetRegisterItem",
  "type": "object",
  "properties": {
    "register_id": {
      "type": "string",
      "description": "Parent ComplianceManagedRegister ID (Asset Register)"
    },
    "asset_id": {
      "type": "string",
      "description": "Human-readable asset ID, e.g. AST-001 \u2014 auto-populated, editable, unique within the register"
    },
    "title": {
      "type": "string",
      "description": "Asset title"
    },
    "serial_number": {
      "type": "string",
      "description": "Optional serial number"
    },
    "description": {
      "type": "string",
      "description": "Asset description"
    },
    "asset_type": {
      "type": "string",
      "description": "Asset type, from the register's configured asset_types list"
    },
    "location": {
      "type": "string",
      "description": "Location, from the register's configured locations list"
    },
    "ownership": {
      "type": "string",
      "description": "Owned or Leased"
    },
    "purchase_date": {
      "type": "string",
      "format": "date",
      "description": "Purchase date (Owned assets)"
    },
    "lease_start_date": {
      "type": "string",
      "format": "date",
      "description": "Lease start date (Leased assets)"
    },
    "lease_end_date": {
      "type": "string",
      "format": "date",
      "description": "Lease end date (Leased assets)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Disposed"
      ],
      "default": "Active",
      "description": "Asset status"
    },
    "condition": {
      "type": "string",
      "description": "Good, Fair or Poor"
    },
    "asset_value": {
      "type": "number",
      "description": "Asset value"
    },
    "warranty_expiry": {
      "type": "string",
      "format": "date",
      "description": "Warranty expiry date"
    },
    "asset_manager": {
      "type": "string",
      "description": "Free-text name of the asset manager"
    },
    "asset_user": {
      "type": "string",
      "description": "Free-text name of the asset user"
    },
    "date_of_disposal": {
      "type": "string",
      "format": "date",
      "description": "Date of disposal (Disposed assets)"
    },
    "sale_proceeds": {
      "type": "number",
      "description": "Sale proceeds on disposal"
    },
    "depreciation_method": {
      "type": "string",
      "description": "No Depreciation, Straight Line, Reducing Balance or Write-off"
    },
    "depreciation_start_date": {
      "type": "string",
      "format": "date",
      "description": "Depreciation start date"
    },
    "calculation_method": {
      "type": "string",
      "description": "Depreciation Rate or Effective Life"
    },
    "depreciation_rate": {
      "type": "number",
      "description": "Depreciation rate percentage (0-100)"
    },
    "effective_life_value": {
      "type": "number",
      "description": "Effective life value"
    },
    "effective_life_unit": {
      "type": "string",
      "description": "Months or Years"
    },
    "depreciation_end_date": {
      "type": "string",
      "format": "date",
      "description": "Auto-calculated depreciation end date"
    },
    "custom_fields": {
      "type": "object",
      "description": "Values for the register's custom columns (config.custom_columns), keyed by custom column id"
    },
    "order_index": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "register_id",
    "title"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}