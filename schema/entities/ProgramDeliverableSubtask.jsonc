{
  "name": "ProgramDeliverableSubtask",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "description": "Owning ProgramDeliverableTask ID"
    },
    "deliverable_id": {
      "type": "string",
      "description": "Parent ProgramDeliverable ID (denormalised for cascades)"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Not Started",
        "In Progress",
        "Completed"
      ],
      "default": "Not Started"
    },
    "owner_name": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string",
      "description": "Rich-text (HTML) description"
    },
    "order_index": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "task_id",
    "title"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}