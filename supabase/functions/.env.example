# Secrets for the Supabase Edge Functions.
# Set them with:  npx supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase automatically.)

# Long random text. Must match the 'cron_secret' you put in Vault (see README).
CRON_SECRET=change-me-to-a-long-random-string

# Web address of the app, used in invite emails, e.g. https://app.example.org
SITE_URL=https://your-app.vercel.app

# AI features (policy Q&A, risk/strategy report narratives). Set ONE of these.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model override, e.g. claude-sonnet-5-5 or gpt-4.1-mini
LLM_MODEL=

# Emails (membership renewal reminders). https://resend.com
RESEND_API_KEY=
EMAIL_FROM=Missionmate <no-reply@your-domain.org>
